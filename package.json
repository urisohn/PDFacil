{
  "name": "pdfacil",
  "version": "1.0.0",
  "description": "PDFacil - an easy PDF viewer and editor",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "dist": "electron-builder --dir && node scripts/copy-exe.js",
    "test": "node test/smoke.cjs",
    "dist:win": "electron-builder --win dir --x64 && node scripts/copy-exe.js",
    "dist:mac": "electron-builder --mac dir && node scripts/copy-exe.js"
  },
  "author": "Uri Simonsohn",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "PDFacil",
  "build": {
    "appId": "com.pdfacil.app",
    "productName": "PDFacil",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "target": [
        {
          "target": "dir"
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    }
  }
}